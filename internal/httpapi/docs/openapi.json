{
  "components": {
    "schemas": {
      "domain.Answer": {
        "properties": {
          "selected_index": {
            "description": "用户选择的选项下标 0-3",
            "example": 0,
            "maximum": 3,
            "minimum": 0,
            "type": "integer"
          },
          "word_id": {
            "description": "题目对应的词汇 ID",
            "example": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "domain.Question": {
        "properties": {
          "options": {
            "description": "四个选项，正确答案下标不返回",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "word": {
            "description": "题目单词",
            "example": "abandon",
            "type": "string"
          },
          "word_id": {
            "description": "词汇 ID",
            "example": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "domain.Test": {
        "properties": {
          "completed": {
            "description": "是否已提交答案",
            "example": false,
            "type": "boolean"
          },
          "completed_at": {
            "description": "提交时间，未完成时为 null",
            "nullable": true,
            "type": "string"
          },
          "correct_count": {
            "description": "答对题数，未完成时为 null",
            "example": 15,
            "nullable": true,
            "type": "integer"
          },
          "estimated_vocabulary": {
            "description": "估算词汇量，未完成时为 null",
            "example": 2887,
            "nullable": true,
            "type": "integer"
          },
          "id": {
            "description": "测试 ID",
            "example": 1,
            "type": "integer"
          },
          "question_count": {
            "description": "题目数量",
            "example": 20,
            "type": "integer"
          },
          "questions": {
            "description": "题目列表",
            "items": {
              "$ref": "#/components/schemas/domain.Question"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "domain.Word": {
        "properties": {
          "id": {
            "description": "词汇 ID",
            "example": 1,
            "type": "integer"
          },
          "level": {
            "description": "难度等级：1 最常用，5 最生僻",
            "example": 1,
            "type": "integer"
          },
          "meaning": {
            "description": "中文释义",
            "example": "v. 放弃；抛弃",
            "type": "string"
          },
          "word": {
            "description": "单词",
            "example": "abandon",
            "type": "string"
          }
        },
        "type": "object"
      },
      "httpapi.CreateTestRequest": {
        "properties": {
          "count": {
            "description": "题目数量，省略或为 0 时默认 20",
            "example": 20,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "httpapi.ErrorResponse": {
        "properties": {
          "error": {
            "description": "错误信息",
            "example": "not found",
            "type": "string"
          }
        },
        "type": "object"
      },
      "httpapi.HealthResponse": {
        "properties": {
          "status": {
            "description": "ok 或 unavailable",
            "example": "ok",
            "type": "string"
          }
        },
        "type": "object"
      },
      "httpapi.SubmitAnswersRequest": {
        "properties": {
          "answers": {
            "description": "答案列表，必须覆盖全部题目",
            "items": {
              "$ref": "#/components/schemas/domain.Answer"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "httpapi.WordInput": {
        "properties": {
          "level": {
            "description": "难度等级：1-5",
            "example": 1,
            "type": "integer"
          },
          "meaning": {
            "description": "中文释义",
            "example": "v. 放弃；抛弃",
            "type": "string"
          },
          "word": {
            "description": "单词",
            "example": "abandon",
            "type": "string"
          }
        },
        "type": "object"
      },
      "httpapi.WordListResponse": {
        "properties": {
          "items": {
            "description": "当前页词汇",
            "items": {
              "$ref": "#/components/schemas/domain.Word"
            },
            "type": "array"
          },
          "total": {
            "description": "符合条件的总数",
            "example": 3849,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "httpapi.WordPatchInput": {
        "properties": {
          "level": {
            "description": "新难度等级：1-5",
            "example": 1,
            "type": "integer"
          },
          "meaning": {
            "description": "新释义",
            "example": "v. 放弃；抛弃",
            "type": "string"
          },
          "word": {
            "description": "新单词",
            "example": "abandon",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "CET-4 词汇量测试后端：词库增删改查、四选一测试、判分和健康检查。测试为匿名，凭测试 ID 提交答案；估算公式为：正确题数 ÷ 题目总数 × 创建测试时的词库总量，结果四舍五入。",
    "title": "CET-4 词汇量测试接口",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/tests": {
      "post": {
        "description": "随机抽题，每个题目有 4 个选项。请求体可省略，count 默认 20；词库不足时返回 400。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/httpapi.CreateTestRequest"
              }
            }
          },
          "description": "题目数量",
          "x-originalParamName": "request"
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Test"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Location": {
                "description": "新测试的路径",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "创建测试并抽题",
        "tags": [
          "Tests"
        ]
      }
    },
    "/api/v1/tests/{id}": {
      "get": {
        "description": "未完成时返回题目；完成后额外返回 correct_count、estimated_vocabulary 和 completed_at。",
        "parameters": [
          {
            "description": "测试 ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Test"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "查询测试",
        "tags": [
          "Tests"
        ]
      }
    },
    "/api/v1/tests/{id}/answers": {
      "post": {
        "description": "答案必须覆盖该测试的全部题目，word_id 不能重复，selected_index 必须在 0-3。已完成的测试再次提交返回 409。",
        "parameters": [
          {
            "description": "测试 ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/httpapi.SubmitAnswersRequest"
              }
            }
          },
          "description": "答案",
          "required": true,
          "x-originalParamName": "answers"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Test"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "提交答案并判分",
        "tags": [
          "Tests"
        ]
      }
    },
    "/api/v1/words": {
      "get": {
        "description": "按 id 升序返回，可按 level 过滤。",
        "parameters": [
          {
            "description": "按难度过滤",
            "in": "query",
            "name": "level",
            "schema": {
              "enum": [
                1,
                2,
                3,
                4,
                5
              ],
              "type": "integer"
            }
          },
          {
            "description": "每页数量",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "偏移量",
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.WordListResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "分页列出词汇",
        "tags": [
          "Words"
        ]
      },
      "post": {
        "description": "单词唯一，重复创建返回 409。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/httpapi.WordInput"
              }
            }
          },
          "description": "词汇",
          "required": true,
          "x-originalParamName": "word"
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Word"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Location": {
                "description": "新词汇的路径",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "新增词汇",
        "tags": [
          "Words"
        ]
      }
    },
    "/api/v1/words/{id}": {
      "delete": {
        "description": "词汇被任何测试引用时返回 409。",
        "parameters": [
          {
            "description": "词汇 ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "删除成功"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "summary": "删除词汇",
        "tags": [
          "Words"
        ]
      },
      "get": {
        "parameters": [
          {
            "description": "词汇 ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Word"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "查询单个词汇",
        "tags": [
          "Words"
        ]
      },
      "patch": {
        "description": "至少提供一个字段，只更新传入的字段。",
        "parameters": [
          {
            "description": "词汇 ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/httpapi.WordPatchInput"
              }
            }
          },
          "description": "要更新的字段",
          "required": true,
          "x-originalParamName": "word"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Word"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "局部更新词汇",
        "tags": [
          "Words"
        ]
      },
      "put": {
        "description": "必须提供 word、meaning、level 三个字段。",
        "parameters": [
          {
            "description": "词汇 ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/httpapi.WordInput"
              }
            }
          },
          "description": "词汇",
          "required": true,
          "x-originalParamName": "word"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain.Word"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi.ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
